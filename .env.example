# BUILDLABS — Environment Variables Template
# Safe placeholders only. AI Studio injects secrets from the Secrets panel.
# DO NOT commit real secrets or service-role keys.

# Gemini AI API Configuration
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase Authentication & PostgreSQL Database (Phase 1 & 3 Cloud Sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# API & Gateway Base URL
API_BASE_URL=https://api.buildlabs.ai
